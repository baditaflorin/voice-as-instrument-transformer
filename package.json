{
  "name": "voice-as-instrument-transformer",
  "version": "0.1.0",
  "description": "Turn live speech or singing into pitch-tracked Rhodes, cello, and synth performances in the browser.",
  "private": false,
  "homepage": "https://baditaflorin.github.io/voice-as-instrument-transformer/",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "postbuild": "node scripts/after-build.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "pages:preview": "npm run build && npx vite preview --host 127.0.0.1",
    "deploy:pages": "npm run build && gh-pages -d dist -b gh-pages --dotfiles -m \"ops: publish github pages\"",
    "test": "vitest run --coverage=false",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "smoke": "bash scripts/smoke.sh",
    "lint": "eslint . && prettier --check . && tsc --noEmit",
    "fmt": "prettier --write .",
    "hooks:pre-commit": "bash .githooks/pre-commit",
    "hooks:commit-msg": "bash .githooks/commit-msg .git/COMMIT_EDITMSG",
    "hooks:pre-push": "bash .githooks/pre-push"
  },
  "keywords": [
    "web-audio",
    "tonejs",
    "pitch-detection",
    "voice",
    "crepe",
    "whisper",
    "vocoder"
  ],
  "author": "Florin Badita",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@tanstack/react-query": "^5.100.9",
    "lucide-react": "^1.14.0",
    "pitchy": "^4.1.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tone": "^15.1.22",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "gh-pages": "^6.3.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.14",
    "prettier": "^3.8.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.11",
    "vitest": "^4.1.5"
  }
}
